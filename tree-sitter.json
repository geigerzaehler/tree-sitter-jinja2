{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "jinja2",
      "camelcase": "Jinja2",
      "scope": "source.jinja2",
      "path": ".",
      "file-types": null,
      "injection-regex": "^jinja2$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Jinja2 grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/geigerzaehler/tree-sitter-jinja2"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}